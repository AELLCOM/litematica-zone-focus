{
	"schemaVersion": 1,
	"id": "zonefocus",
	"version": "${version}",
	"name": "Litematica Zone Focus",
	"description": "Splits a Litematica schematic into zones, renders only the zone you are building, tracks its progress and checks it against the schematic.",
	"authors": [
		"Aell_"
	],
	"contact": {
		"discord": "https://discord.gg/jTU2yawThv"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/zonefocus/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.aell.zonefocus.ZoneFocusClient"
		],
		"modmenu": [
			"com.aell.zonefocus.compat.ModMenuImpl"
		]
	},
	"mixins": [
		{
			"config": "zonefocus.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_min}",
		"malilib": ">=${malilib_version}",
		"litematica": ">=${litematica_version}"
	},
	"breaks": {
		"regionhud": "*"
	}
}
